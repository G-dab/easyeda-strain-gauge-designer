{
	"name": "strain-bridge-designer",
	"type": "module",
	"version": "0.2.0",
	"private": true,
	"description": "Parameter-driven quadrant orthogonal bridge designer for JLCEDA Pro",
	"author": "G-dab",
	"license": "Apache-2.0",
	"homepage": "https://github.com/G-dab/easyeda-strain-gauge-designer",
	"repository": {
		"type": "git",
		"url": "https://github.com/G-dab/easyeda-strain-gauge-designer.git"
	},
	"bugs": {
		"url": "https://github.com/G-dab/easyeda-strain-gauge-designer/issues"
	},
	"engines": {
		"node": ">=20.17.0"
	},
	"scripts": {
		"compile": "rimraf ./dist/ && ts-node ./config/esbuild.prod.ts && node scripts/build-ui.mjs",
		"lint": "eslint",
		"fix": "eslint --fix",
		"build": "npm run compile && ts-node ./build/packaged.ts",
		"debug": "ts-node ./build/dev.ts",
		"update:check": "ts-node ./build/update.ts check",
		"update": "ts-node ./build/update.ts update && npm install",
		"manifest:generate": "npm install && ts-node ./build/manifest.ts generate",
		"manifest:bump": "npm install && ts-node ./build/manifest.ts bump && npm install",
		"typecheck": "tsc --noEmit",
		"test": "node scripts/test.mjs",
		"preview": "node scripts/build-ui.mjs && node scripts/preview.mjs"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^5.4.1",
		"@jlceda/pro-api-types": "^0.4.26",
		"@types/fs-extra": "^11.0.4",
		"@types/ws": "^8.5.13",
		"esbuild": "^0.24.2",
		"eslint": "^9.37.0",
		"fs-extra": "^11.3.0",
		"ignore": "^7.0.3",
		"jszip": "^3.10.1",
		"lint-staged": "^16.2.3",
		"rimraf": "^6.0.1",
		"simple-git-hooks": "^2.13.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3",
		"ws": "^8.18.0"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*": "eslint --fix"
	}
}
